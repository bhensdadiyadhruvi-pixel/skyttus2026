@model IEnumerable<MvcEfApp.Models.Student>

<h2>Student List</h2>

<table border="1">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Department</th>
        <th>Marks</th>
    </tr>

@foreach (var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@item.Name</td>
        <td>@item.Department</td>
        <td>@item.Marks</td>
    </tr>
}
</table>